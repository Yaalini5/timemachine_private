# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# PIN these for the final evaluation so results are reproducible (verify names in AI Studio).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Seconds to wait between API calls (free tier is rate limited).
GEMINI_MIN_INTERVAL=4
